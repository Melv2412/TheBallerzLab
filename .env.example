# Copier ce fichier en .env (jamais commité) ou définir ces variables chez l'hébergeur.
# En local, aucune variable n'est nécessaire : SQLite + /media + DEBUG.

# --- Django ---
DJANGO_SECRET_KEY=une-longue-chaine-aleatoire
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=mon-api.up.railway.app
CSRF_TRUSTED_ORIGINS=https://mon-api.up.railway.app
CORS_ALLOWED_ORIGINS=https://mon-front.vercel.app

# --- Base de données (Supabase > Connect > Connection string) ---
# Serverless (Vercel) : pooler en mode transaction, port 6543
# Serveur classique (Railway) : connexion directe ou pooler en mode session, port 5432
DATABASE_URL=postgresql://postgres.<projet>:<mot-de-passe>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
# Durée de vie des connexions (0 avec le pooler en mode transaction, ex. 60 sur un serveur classique)
DB_CONN_MAX_AGE=0

# --- Médias : logos et photos (Supabase > Storage > S3 Connection) ---
# Créer un bucket public nommé "media"
STORAGE_BUCKET=media
STORAGE_S3_ENDPOINT=https://<projet>.supabase.co/storage/v1/s3
STORAGE_S3_REGION=eu-west-3
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_DOMAIN=<projet>.supabase.co/storage/v1/object/public/media
