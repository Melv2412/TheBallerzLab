# Variables à définir dans Vercel (projet backend > Settings > Environment Variables).
# En local, aucune variable n'est nécessaire : SQLite + /media + DEBUG.

# --- Django ---
DJANGO_SECRET_KEY=une-longue-chaine-aleatoire
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=thelab-api.vercel.app
CSRF_TRUSTED_ORIGINS=https://thelab-api.vercel.app
CORS_ALLOWED_ORIGINS=https://thelab.vercel.app

# --- Base de données (Supabase > Connect > Connection string) ---
# Sur Vercel (serverless) : "Transaction pooler", port 6543
DATABASE_URL=postgresql://postgres.<projet>:<mot-de-passe>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
# Les connexions ne sont pas gardées ouvertes (obligatoire avec le pooler en mode transaction)
DB_CONN_MAX_AGE=0

# --- Médias : logos et photos (Supabase > Storage > S3 Connection) ---
# Créer un bucket public nommé "media"
STORAGE_BUCKET=media
STORAGE_S3_ENDPOINT=https://<projet>.supabase.co/storage/v1/s3
STORAGE_S3_REGION=eu-west-3
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_DOMAIN=<projet>.supabase.co/storage/v1/object/public/media
